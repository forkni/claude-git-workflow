#!/usr/bin/env bash
# Pre-push hook — validates commits before they leave local repo.
# Part of claude-git-workflow. Sources _common.sh at run time so changes
# to CGW_LOCAL_FILES and CGW_EXTRA_PREFIXES in .cgw.conf take effect
# without re-running configure.sh.
#
# Checks all commits about to be pushed:
#   1. No local-only files tracked in any unpushed commit
#   2. All commit messages follow conventional format
#
# This complements push_validated.sh (CGW wrapper) by catching issues
# even when users bypass the wrapper and run git push directly.
# See Pro Git Ch8 p.362 — pre-push hook.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# scripts/git/ is gitignored in some installs, so git never checks it out into a
# linked worktree. Hooks are shared across worktrees ($GIT_COMMON_DIR/hooks), so
# fall back to the MAIN worktree for the tooling. Only the TOOLING comes from
# there — _config.sh still derives PROJECT_ROOT from the cwd, so every git
# operation stays scoped to the worktree the caller is standing in.
CGW_HOME="${REPO_ROOT}"
if [[ ! -f "${CGW_HOME}/scripts/git/_common.sh" ]]; then
  _cgw_main="$(git worktree list --porcelain 2>/dev/null | head -1)"
  _cgw_main="${_cgw_main#worktree }"
  [[ -n "${_cgw_main}" ]] && CGW_HOME="${_cgw_main}"
fi

# Fail CLOSED. Without _common.sh, cgw_filter_local_files is undefined and the
# `|| true` swallows it — the local-only-file guard then reports a false pass.
# A blocked push is recoverable; a silent bypass is not.
if [[ ! -f "${CGW_HOME}/scripts/git/_common.sh" ]]; then
  echo "ERROR [pre-push]: CGW not found at ${CGW_HOME}/scripts/git/_common.sh" >&2
  echo "  Re-run scripts/git/configure.sh, or bypass once with --no-verify." >&2
  exit 1
fi
# shellcheck source=scripts/git/_common.sh
source "${CGW_HOME}/scripts/git/_common.sh"

# CGW_ALL_PREFIXES is computed by _config.sh (sourced via _common.sh above)
# and includes CGW_EXTRA_PREFIXES from .cgw.conf automatically.

# Collect push info from stdin (git passes it to pre-push)
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip deletions (empty sha = 0000...0)
  if [[ "${LOCAL_SHA}" = "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  # Determine commit range to check. In both cases, exclude commits already
  # reachable from ANY remote-tracking ref — a commit already vetted and
  # pushed on one branch (e.g. development) must not be re-flagged just
  # because it's the first time that history reaches a different branch
  # (e.g. a long-lived development -> main merge). Only genuinely new,
  # never-pushed-anywhere commits need checking here.
  if [[ "${REMOTE_SHA}" = "0000000000000000000000000000000000000000" ]]; then
    # New branch being pushed — check all commits not in any remote branch
    RANGE="${LOCAL_SHA}"
  else
    RANGE="${REMOTE_SHA}..${LOCAL_SHA}"
  fi
  COMMITS=$(git rev-list "${RANGE}" --not --remotes 2>/dev/null || true)

  [[ -z "${COMMITS}" ]] && continue

  echo "pre-push: checking $(echo "${COMMITS}" | wc -l | tr -d ' ') commit(s) in ${LOCAL_REF}..."

  # ── [1] Local-only file check ──────────────────────────────────────────
  for COMMIT in ${COMMITS}; do
    mapfile -t PROBLEM < <(
      git diff-tree --no-commit-id -r --name-only --diff-filter=AM "${COMMIT}" 2>/dev/null \
        | cgw_filter_local_files || true
    )
    if (( ${#PROBLEM[@]} > 0 )); then
      echo ""
      echo "ERROR [pre-push]: Commit ${COMMIT} contains local-only files:"
      printf '  %s\n' "${PROBLEM[@]}"
      echo ""
      echo "To fix: git rebase -i HEAD~N and drop/edit the offending commit"
      echo ""
      exit 1
    fi
  done

  # ── [2] Conventional commit format check ──────────────────────────────
  if [[ -n "${CGW_ALL_PREFIXES}" ]]; then
    for COMMIT in ${COMMITS}; do
      MSG=$(git log -1 --format="%s" "${COMMIT}" 2>/dev/null || true)

      # Skip merge commits (they often have non-conventional messages)
      PARENT_COUNT=$(git cat-file -p "${COMMIT}" 2>/dev/null | grep -c "^parent " || true)
      [[ "${PARENT_COUNT}" -ge 2 ]] && continue

      if ! cgw_validate_commit_message "${MSG}"; then
        echo ""
        echo "WARNING [pre-push]: Commit ${COMMIT} has non-conventional message:"
        echo "  ${MSG}"
        echo ""
        echo "Expected format: <type>: <description>"
        echo "Types: ${CGW_ALL_PREFIXES}"
        echo ""
        echo "Push blocked. Fix with: ./scripts/git/undo_last.sh amend-message '<type>: <msg>'"
        echo "Or bypass (not recommended): git push --no-verify"
        echo ""
        exit 1
      fi
    done
  fi

done

echo "pre-push: all checks passed"
echo ""
exit 0
